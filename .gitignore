# Go backend
/backend/bin/
/backend/data/          # cache: SQLite + audio scrapeado (no versionar)
# stdout/stderr del servicio launchd (gitignore no soporta comentarios inline)
/backend/*.log
*.test
*.out

# Swift / Xcode
.build/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/

# macOS
.DS_Store

# Env / secrets
.env
*.local

backend/data/*/covers/*
backend/data/*/tracks/*.mp3
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Swift compiler leftovers that land outside .build/
VGRadio/*.o
VGRadio/*.d
VGRadio/*.swiftdeps
